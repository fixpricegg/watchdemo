# Export these variables in the shell; this file is documentation, not auto-loaded.
WATCHDEMO_DATABASE_URL=postgresql://watchdemo:change-me@127.0.0.1:5432/watchdemo
# Temporary .dem inputs, independent of the process working directory.
WATCHDEMO_UPLOAD_DIR=./uploads
# Integration tests use ONLY this separate explicit connection, never the app URL.
# WATCHDEMO_TEST_DATABASE_URL=postgresql://watchdemo_test:change-me@127.0.0.1:5432/watchdemo_test
# Secure defaults require HTTPS. ONLY for local HTTP development:
# WATCHDEMO_COOKIE_SECURE=false
WATCHDEMO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WATCHDEMO_FRONTEND_URL=http://127.0.0.1:5173
WATCHDEMO_SMTP_HOST=127.0.0.1
WATCHDEMO_SMTP_PORT=1025
# Default starttls; use none ONLY for loopback test mail servers, ssl for SMTPS.
WATCHDEMO_SMTP_TLS=starttls
WATCHDEMO_SMTP_FROM=watchdemo@localhost
# WATCHDEMO_SMTP_USER=
# WATCHDEMO_SMTP_PASSWORD=
